FROM node:22-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json ./
COPY backend/package.json backend/package.json
COPY simulated-company/package.json simulated-company/package.json
COPY frontend/package.json frontend/package.json
RUN npm ci --include=dev --workspace=simulated-company --include-workspace-root

COPY . .
RUN npm run build --workspace=simulated-company

ENV NODE_ENV=production
ENV PORTAL_DATABASE_PATH=/data/simulated_company.sqlite
EXPOSE 4001

CMD ["npm", "run", "start", "--workspace=simulated-company"]
