FROM node:22-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json ./
COPY backend/package.json backend/package.json
COPY simulated-company/package.json simulated-company/package.json
COPY frontend/package.json frontend/package.json
RUN npm ci --include=dev --workspace=backend --include-workspace-root
RUN npx playwright install --with-deps chromium

COPY . .
RUN npm run build --workspace=backend

ENV NODE_ENV=production
ENV DATABASE_PATH=/data/taskpilot.sqlite
ENV SCREENSHOTS_DIR=/data/screenshots
EXPOSE 4000

CMD ["npm", "run", "start", "--workspace=backend"]
