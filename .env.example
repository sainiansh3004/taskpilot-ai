# TaskPilot AI Environment Configuration

# Backend Server
PORT=4000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Simulated Company Portal
SIMULATED_PORTAL_PORT=4001
SIMULATED_PORTAL_URL=http://localhost:4001

# Agent Execution Bounds & Limits
MAX_STEPS=15
MAX_RETRIES_PER_ACTION=3
ACTION_TIMEOUT_MS=15000
TASK_TOTAL_TIMEOUT_MS=120000

# Security & Consequential Actions
REQUIRE_APPROVAL_FOR_WRITES=true
RESTRICT_BROWSER_TO_LOCALHOST=true

# AI Provider Configuration
# Set OPENAI_API_KEY to use real OpenAI models (e.g. gpt-4o, gpt-4o-mini).
# If left empty, TaskPilot AI automatically runs its built-in deterministic autonomous engine!
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database Storage
DATABASE_PATH=./data/taskpilot.sqlite
PORTAL_DATABASE_PATH=./data/simulated_company.sqlite
